<?xml version="1.0" encoding="UTF-8" standalone="yes"?><p:notes xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr/><p:sp><p:nvSpPr><p:cNvPr id="2" name="Original speaker notes"/><p:cNvSpPr/><p:nvPr><p:ph type="body" idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:t xml:space="preserve">{</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "id": "graduate-destinations",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "title": "毕业生规模与去向",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "section": "数据展示",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "minutes": 2.0,</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "purpose": "从规模变化和去向分布两个方面呈现毕业生情况。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "talk": [</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "全国毕业生规模采用2024—2026届预计数，单位万人。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "去向分布仅以黄河科技学院2024届本科生为案例，不能外推全国。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "未落实14.83%由100%减去85.17%计算，不等同失业率；两组图使用各自明确的量尺。"</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  ],</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "transition": "规模和去向之外，还要看行业岗位需求的变化。"</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">}</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:notes>