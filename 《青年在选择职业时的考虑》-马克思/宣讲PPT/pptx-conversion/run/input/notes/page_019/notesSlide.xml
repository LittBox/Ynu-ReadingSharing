<?xml version="1.0" encoding="UTF-8" standalone="yes"?><p:notes xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr/><p:sp><p:nvSpPr><p:cNvPr id="2" name="Original speaker notes"/><p:cNvSpPr/><p:nvPr><p:ph type="body" idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:t xml:space="preserve">{</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "id": "study-grassroots",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "title": "延迟选择与下沉选择",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "section": "就业方向地图",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "minutes": 1.25,</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "purpose": "说明升学深造与基层项目是不同路径。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "talk": [</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "介绍国内考研、境外申请、直博或科研助理等深造入口。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "介绍西部计划、三支一扶与社区工作者等基层入口。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "两类都需独立考察，不一概称为退路；插图仅表现学习与社区服务。"</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  ],</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "transition": "最后补充自由职业和军警方向，完成八类方向介绍。"</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">}</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:notes>