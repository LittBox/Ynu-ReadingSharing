<?xml version="1.0" encoding="UTF-8" standalone="yes"?><p:notes xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr/><p:sp><p:nvSpPr><p:cNvPr id="2" name="Original speaker notes"/><p:cNvSpPr/><p:nvPr><p:ph type="body" idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:t xml:space="preserve">{</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "id": "industry-demand",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "title": "行业需求观察：先分清长期结构与短期变化",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "section": "数据展示",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "minutes": 2.0,</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "purpose": "呈现待核实的行业需求变化，区分短期与长期。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "talk": [</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "以2018年末为100，展示2023年末企业法人单位从业人数的行业变化。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "信息软件与科研技术服务业增加，建筑业下降；从业存量不能直接替代当前招聘需求。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "2026年8月短期观察单独说明，不与五年变化率拼接。"</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  ],</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "transition": "行业需求之外，继续观察升学和体制内选择的热度。"</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">}</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:notes>