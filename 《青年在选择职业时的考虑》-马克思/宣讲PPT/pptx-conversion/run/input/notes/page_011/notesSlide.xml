<?xml version="1.0" encoding="UTF-8" standalone="yes"?><p:notes xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr/><p:sp><p:nvSpPr><p:cNvPr id="2" name="Original speaker notes"/><p:cNvSpPr/><p:nvPr><p:ph type="body" idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:t xml:space="preserve">{</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "id": "youth-employment-baseline",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "title": "16—24岁失业率环比上升3个百分点",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "section": "数据展示",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "minutes": 2.0,</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "purpose": "以待核实指标呈现青年就业基本面。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "talk": [</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "先读统计范围：城镇、不含在校生的劳动力失业率。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "比较7月与6月：16—24岁增加3个百分点，25—29岁增加0.1个百分点；6月值由环比差推算。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "分母是劳动力人口，不能解释为全部同龄青年的比例；两组条形统一20%满宽。"</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  ],</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "transition": "从就业基本面继续观察毕业生规模和去向结构。"</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">}</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:notes>