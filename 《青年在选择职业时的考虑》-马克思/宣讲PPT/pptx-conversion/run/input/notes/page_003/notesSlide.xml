<?xml version="1.0" encoding="UTF-8" standalone="yes"?><p:notes xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr/><p:sp><p:nvSpPr><p:cNvPr id="2" name="Original speaker notes"/><p:cNvSpPr/><p:nvPr><p:ph type="body" idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:t xml:space="preserve">{</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "id": "choice-question",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "title": "你更怕选错，还是更怕没得选？",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "section": "开场引入",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "minutes": 2.0,</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "purpose": "通过“选错／没得选”问题引出热情与现实。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "talk": [</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "请听众在更怕选错和更怕没得选之间作一次直观选择。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "承接两种担心：选择判断与现实机会都值得考察。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "过渡到17岁的马克思也曾面对热情与现实的问题。"</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  ],</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "transition": "带着热情与现实的困惑，转向这篇文章为什么值得读。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "interaction": "请现场举手或短暂回应。"</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">}</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:notes>