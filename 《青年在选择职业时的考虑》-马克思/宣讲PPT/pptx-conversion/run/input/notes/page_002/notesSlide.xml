<?xml version="1.0" encoding="UTF-8" standalone="yes"?><p:notes xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr/><p:sp><p:nvSpPr><p:cNvPr id="2" name="Original speaker notes"/><p:cNvSpPr/><p:nvPr><p:ph type="body" idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:t xml:space="preserve">{</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "id": "employment-news",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "title": "开场新闻：青年就业环境",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "section": "开场引入",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "minutes": 1.5,</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "purpose": "以已核验的国家统计局新闻引出青年就业环境与个人选择的关系。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "talk": [</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "介绍国家统计局2026年9月15日答记者问：8月全国城镇调查失业率5.3%，环比上升0.1个百分点。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "交代统计局对毕业生集中进入劳动力市场的季节性解释，不把总体指标当作青年专属指标。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "用环境变化引出个人选择，不由单月数据直接判断某个人的前途。"</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  ],</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "transition": "环境变化带来选择压力，接着请听众回应最担心什么。"</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">}</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:notes>