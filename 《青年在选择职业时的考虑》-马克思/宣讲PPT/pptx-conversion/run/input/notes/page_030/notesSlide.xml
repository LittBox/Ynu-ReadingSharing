<?xml version="1.0" encoding="UTF-8" standalone="yes"?><p:notes xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr/><p:sp><p:nvSpPr><p:cNvPr id="2" name="Original speaker notes"/><p:cNvSpPr/><p:nvPr><p:ph type="body" idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:t xml:space="preserve">{</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "id": "closing-question",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "title": "离场前，带走一个问题",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "section": "结尾升华",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "minutes": 3.0,</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "purpose": "留下思考问题和三条行动提示，完成现场收束。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "talk": [</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "提出离场问题：如果第一份工作不是最适合的，准备如何在实践中重新理解它。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "按本页原纲列3个方向、各找2条可验证信息，并准备能说明做过什么的证据。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "保留调整空间；这是有实质内容的收尾，保留插图、导航和三个同级行动，不改成纯致谢封面。"</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  ],</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "transition": "以原稿问题和三条行动提示结束本次分享。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "interaction": "留1—2分钟现场回应或默想。"</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">}</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:notes>