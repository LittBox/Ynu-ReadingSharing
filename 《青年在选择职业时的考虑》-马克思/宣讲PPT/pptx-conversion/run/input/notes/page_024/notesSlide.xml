<?xml version="1.0" encoding="UTF-8" standalone="yes"?><p:notes xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr/><p:sp><p:nvSpPr><p:cNvPr id="2" name="Original speaker notes"/><p:cNvSpPr/><p:nvPr><p:ph type="body" idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:t xml:space="preserve">{</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "id": "capability-evidence",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "title": "把“我喜欢”转成“我做过什么、能证明什么”",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "section": "能力矩阵",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "minutes": 1.0,</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "purpose": "将兴趣表达转向可证明经历，并说明矩阵用法。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "talk": [</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "分别纠正兴趣等于能力、证书等于证据、听说等于标准三类误区。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "把喜欢转成做过什么和能证明什么，并核对公开要求。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "本页练习沿原纲：选1—2个方向，各找3条可验证信息；结尾另有3个方向、各2条的信息练习。"</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  ],</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "transition": "把证据意识带入选拔与经历，讨论信息不对称。"</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">}</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:notes>