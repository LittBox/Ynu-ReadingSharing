<?xml version="1.0" encoding="UTF-8" standalone="yes"?><p:notes xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr/><p:sp><p:nvSpPr><p:cNvPr id="2" name="Original speaker notes"/><p:cNvSpPr/><p:nvPr><p:ph type="body" idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:t xml:space="preserve">{</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "id": "luo-career-recognition",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "title": "选择时不喜欢，后来为什么喜欢了",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "section": "案例与经历",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "minutes": 2.0,</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "purpose": "借已核验的公开访谈，说明职业认知可能在学习与实践中变化。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "talk": [</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "来源为南方周末账号在南方+发布的2020年5月4日公开访谈，截图保留标题和回答。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "概括本人回答：父母选择法律，他当时不了解；后来觉得刑法课有趣，就喜欢学习。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "职业认知在学习与实践中变化是宣讲提炼，不伪装成原话，也不使用未核验的鲁豫节目截图。"</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  ],</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "transition": "把案例中的认知变化归结到选择与实践的关系。"</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">}</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:notes>