<?xml version="1.0" encoding="UTF-8" standalone="yes"?><p:notes xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr/><p:sp><p:nvSpPr><p:cNvPr id="2" name="Original speaker notes"/><p:cNvSpPr/><p:nvPr><p:ph type="body" idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:t xml:space="preserve">{</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "id": "happiness-and-perfection",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "title": "个人幸福与自身完善，不是二选一",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "section": "理论主体",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "minutes": 1.5,</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "purpose": "说明个人幸福与自身完善在职业实践中统一的可能。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "talk": [</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "区分尊重个人与只顾自己，也避免把整体利益理解成抽象牺牲。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "个人成长和他人需要可以在具体职业实践中发生联系。",</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">    "落到人类幸福与自身完善的关系，避免作个人幸福的保证。"</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  ],</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">  "transition": "回到原文，检查四个命题各自对应的文字依据。"</a:t></a:r></a:p><a:p><a:r><a:t xml:space="preserve">}</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:notes>